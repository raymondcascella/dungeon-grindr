# Copy this file to android/keystore.properties (gitignored — never commit the real file)
# Then fill in actual values after generating your keystore.
#
# Generate keystore (run once, store the .jks file OUTSIDE the git repo):
#   keytool -genkey -v -keystore C:\keystore\dungeon_grindr.jks \
#     -alias dungeon_grindr -keyalg RSA -keysize 2048 -validity 10000
#
# CRITICAL: Back up dungeon_grindr.jks and these passwords securely.
# Losing the keystore means you cannot update your Play Store listing.

storeFile=C:\\keystore\\dungeon_grindr.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=dungeon_grindr
keyPassword=YOUR_KEY_PASSWORD
